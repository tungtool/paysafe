# Sao chép file này thành ".env" rồi điền giá trị thật vào

# Cổng server
PORT=3000

# Khóa ký JWT (đăng nhập) - đổi thành chuỗi ngẫu nhiên dài, giữ bí mật
JWT_SECRET=change-this-to-a-long-random-secret

# Tài khoản admin khởi tạo (chỉ dùng lần đầu chạy, sau đó nên đổi mật khẩu trong DB)
ADMIN_EMAIL=admin@yourdomain.vn
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Admin

# Phí dịch vụ escrow (%), ví dụ 1 = 1%
SERVICE_FEE_PERCENT=1

# ===== VNPAY (cổng thu tiền vào escrow) =====
# Lấy tại: https://sandbox.vnpayment.vn/devreadme/ (đăng ký merchant thật để lấy các giá trị production)
VNPAY_TMN_CODE=YOUR_TMN_CODE
VNPAY_HASH_SECRET=YOUR_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/payments/vnpay/return
VNPAY_IPN_URL=http://localhost:3000/api/payments/vnpay/ipn

# ===== Thông tin ngân hàng của công ty (để giải ngân thủ công cho người bán) =====
# VNPay/Momo/ZaloPay đa số chỉ hỗ trợ THU tiền qua API cho merchant thường.
# Việc CHI tiền (giải ngân) thường phải làm thủ công qua Internet Banking / hoặc
# API chi hộ nếu bạn đã ký hợp đồng riêng với ngân hàng. App này quản lý việc đó
# ở trạng thái "payout: pending" để admin xác nhận đã chuyển khoản thật.
COMPANY_BANK_NAME=Vietcombank
COMPANY_BANK_ACCOUNT=0123456789
COMPANY_BANK_HOLDER=CONG TY SAFEPAY
